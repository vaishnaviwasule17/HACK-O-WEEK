/* ---------------- Face Attendance ---------------- */
let streams = {};
async function startCamera(which){
  const video = document.getElementById('video-'+which);
  const stateEl = document.getElementById(which==='mark'?'mark-state':'reg-state');
  try{
    const stream = await navigator.mediaDevices.getUserMedia({video:{width:340,height:255, facingMode:'user'}});
    streams[which] = stream;
    video.srcObject = stream;
    stateEl.textContent = 'Camera live — center your face';
    if(which==='mark') document.getElementById('btn-recognize').disabled = false;
    if(which==='register') document.getElementById('btn-capture').disabled = false;
  }catch(e){
    stateEl.textContent = 'Camera unavailable: ' + e.message;
  }
}

// Downsample the centered oval region to a small grayscale descriptor
function getDescriptorFromVideo(video){
  const size = 32;
  const c = document.createElement('canvas'); c.width=size; c.height=size;
  const ctx = c.getContext('2d');
  const vw = video.videoWidth||340, vh = video.videoHeight||255;
  const cropW = vw*0.42, cropH = vh*0.62;
  const sx = (vw-cropW)/2, sy = (vh-cropH)/2;
  ctx.drawImage(video, sx, sy, cropW, cropH, 0, 0, size, size);
  const data = ctx.getImageData(0,0,size,size).data;
  const gray = [];
  for(let i=0;i<data.length;i+=4){
    gray.push(0.299*data[i]+0.587*data[i+1]+0.114*data[i+2]);
  }
  const mean = gray.reduce((a,b)=>a+b,0)/gray.length;
  const std = Math.sqrt(gray.reduce((a,b)=>a+(b-mean)*(b-mean),0)/gray.length) || 1;
  return gray.map(v=>(v-mean)/std);
}
function thumbFromVideo(video){
  const c = document.createElement('canvas'); c.width=120; c.height=150;
  const ctx = c.getContext('2d');
  const vw = video.videoWidth||340, vh = video.videoHeight||255;
  const cropW = vw*0.42, cropH = vh*0.62;
  const sx = (vw-cropW)/2, sy = (vh-cropH)/2;
  ctx.drawImage(video, sx, sy, cropW, cropH, 0, 0, 120, 150);
  return c.toDataURL('image/jpeg', 0.7);
}
function distance(a,b){
  let sum=0; for(let i=0;i<a.length;i++){ const d=a[i]-b[i]; sum += d*d; }
  return Math.sqrt(sum/a.length);
}

let pendingCapture = null;
function captureFace(){
  const video = document.getElementById('video-register');
  if(!video.videoWidth){ alert('Camera still starting up, try again in a second.'); return; }
  pendingCapture = { descriptor: getDescriptorFromVideo(video), thumb: thumbFromVideo(video) };
  document.getElementById('capture-thumb').innerHTML = `<div class="thumb"><img src="${pendingCapture.thumb}"></div>`;
  document.getElementById('reg-state').textContent = 'Face captured ✓ — fill in details and save';
}
async function saveStudent(){
  const name = document.getElementById('reg-name').value.trim();
  const roll = document.getElementById('reg-roll').value.trim();
  const batch = document.getElementById('reg-batch').value.trim();
  if(!name){ alert('Enter the student name.'); return; }
  if(!pendingCapture){ alert('Capture a face photo first.'); return; }
  DB.students.push({id:uid(), name, roll, batch, descriptor:pendingCapture.descriptor, thumb:pendingCapture.thumb});
  await saveAll();
  logActivity(`Registered new student: ${name}`, 'Attendance');
  pendingCapture = null;
  document.getElementById('capture-thumb').innerHTML='';
  document.getElementById('reg-name').value=''; document.getElementById('reg-roll').value=''; document.getElementById('reg-batch').value='';
  document.getElementById('reg-state').textContent = 'Saved ✓ — capture next student';
  renderRoster();
}

function renderRoster(){
  document.getElementById('roster-count').textContent = DB.students.length;
  document.getElementById('roster-list').innerHTML = DB.students.map(s=>{
    const marked = DB.attendance.some(a=>a.studentId===s.id && a.date===todayStr());
    return `<div class="roster-row"><img src="${s.thumb}"><div style="flex:1;">
      <div class="name">${s.name}</div><div class="meta">${s.roll||'—'} · ${s.batch||'—'}</div></div>
      ${marked?'<span class="badge good">Present</span>':'<span class="badge chalk">Pending</span>'}</div>`;
  }).join('') || `<div class="empty">No students registered yet. Use the "Register Student" tab.</div>`;
}

function recognizeFace(){
  const video = document.getElementById('video-mark');
  const stateEl = document.getElementById('mark-state');
  if(!video.videoWidth){ stateEl.textContent='Camera still starting up…'; return; }
  if(DB.students.length===0){ stateEl.textContent='No students registered yet.'; return; }
  const desc = getDescriptorFromVideo(video);
  let best=null, bestDist=Infinity;
  DB.students.forEach(s=>{
    const d = distance(desc, s.descriptor);
    if(d<bestDist){ bestDist=d; best=s; }
  });
  const THRESHOLD = 0.98;
  if(bestDist > THRESHOLD){
    stateEl.textContent = `No confident match (Δ${bestDist.toFixed(2)}). Try better lighting / centering.`;
    return;
  }
  const confidence = Math.max(0, Math.round((1 - bestDist/THRESHOLD)*100));
  const already = DB.attendance.find(a=>a.studentId===best.id && a.date===todayStr());
  if(already){
    stateEl.textContent = `${best.name} already marked present today at ${already.time}.`;
    return;
  }
  DB.attendance.unshift({id:uid(), studentId:best.id, name:best.name, roll:best.roll, date:todayStr(), time:nowStr(), confidence, status:'Present'});
  saveAll();
  logActivity(`${best.name} marked present (face match ${confidence}%)`, 'Attendance');
  stateEl.textContent = `✓ ${best.name} marked present — confidence ${confidence}%`;
  renderRoster(); renderLog(); renderDashboard();
}

function renderLog(){
  document.getElementById('log-date').textContent = todayStr();
  const todays = DB.attendance.filter(a=>a.date===todayStr());
  document.getElementById('log-body').innerHTML = todays.map(a=>
    `<tr><td>${a.name}</td><td>${a.roll||'—'}</td><td>${a.time}</td><td>${a.confidence}%</td><td><span class="badge good">${a.status}</span></td></tr>`
  ).join('') || `<tr><td colspan="5" class="empty">No attendance marked yet today.</td></tr>`;
}
function exportCSV(){
  const rows = [['Name','Roll No','Date','Time','Confidence','Status'], ...DB.attendance.map(a=>[a.name,a.roll||'',a.date,a.time,a.confidence+'%',a.status])];
  const csv = rows.map(r=>r.map(v=>`"${v}"`).join(',')).join('\n');
  const blob = new Blob([csv], {type:'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download='attendance_export.csv'; a.click();
  URL.revokeObjectURL(url);
}

