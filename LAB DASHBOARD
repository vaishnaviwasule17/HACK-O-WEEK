<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LabGrid · Cloud Lab &amp; Attendance Console</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
:root{
  --bg: #0E2A47;
  --bg-deep: #0A2138;
  --panel: #123A5E;
  --panel-2: #163F66;
  --line: rgba(255,255,255,0.09);
  --line-strong: rgba(255,255,255,0.18);
  --ink: #EAF2FB;
  --ink-muted: #9FB8D1;
  --chalk: #7DD3FC;
  --amber: #F5A524;
  --good: #34D399;
  --bad: #F87171;
  --warn: #FBBF24;
  --font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
  --font-body: 'IBM Plex Sans', 'Segoe UI', sans-serif;
  --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;}
body{
  background:
    linear-gradient(var(--line) 1px, transparent 1px) 0 0/40px 40px,
    linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0/40px 40px,
    var(--bg);
  color:var(--ink);
  font-family:var(--font-body);
  font-size:14px;
  min-height:100vh;
}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:4px;}

.app{display:grid;grid-template-columns:236px 1fr;min-height:100vh;}

/* Sidebar */
.sidebar{
  background:var(--bg-deep);
  border-right:1px solid var(--line);
  padding:22px 14px;
  display:flex;flex-direction:column;gap:6px;
  position:sticky;top:0;height:100vh;
}
.brand{display:flex;align-items:center;gap:10px;padding:4px 8px 20px;}
.brand-mark{
  width:34px;height:34px;border-radius:8px;
  background:linear-gradient(135deg,var(--chalk),var(--amber));
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-weight:600;color:var(--bg-deep);font-size:13px;
}
.brand-name{font-family:var(--font-display);font-weight:700;font-size:17px;letter-spacing:.3px;}
.brand-sub{font-family:var(--font-mono);font-size:10px;color:var(--ink-muted);letter-spacing:1px;text-transform:uppercase;}

.navgroup-label{font-family:var(--font-mono);font-size:10px;color:var(--ink-muted);text-transform:uppercase;letter-spacing:1.5px;padding:14px 10px 6px;}
.navbtn{
  display:flex;align-items:center;gap:10px;
  padding:9px 10px;border-radius:8px;cursor:pointer;
  color:var(--ink-muted);font-size:13.5px;font-weight:500;
  border:1px solid transparent;
  transition:all .12s ease;
  user-select:none;
}
.navbtn:hover{background:rgba(255,255,255,0.04);color:var(--ink);}
.navbtn.active{background:var(--panel);color:var(--ink);border-color:var(--line-strong);}
.navbtn .dot{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.55;flex-shrink:0;}
.navbtn.active .dot{background:var(--chalk);opacity:1;}

.sidebar-foot{margin-top:auto;padding:10px;font-family:var(--font-mono);font-size:10.5px;color:var(--ink-muted);border-top:1px solid var(--line);padding-top:14px;line-height:1.6;}
.pulse{width:7px;height:7px;border-radius:50%;background:var(--good);display:inline-block;box-shadow:0 0 0 0 rgba(52,211,153,.6);animation:pulse 2s infinite;}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(52,211,153,.55);}70%{box-shadow:0 0 0 6px rgba(52,211,153,0);}100%{box-shadow:0 0 0 0 rgba(52,211,153,0);}}

/* Main */
.main{padding:22px 28px 60px;max-width:1280px;}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px;}
.topbar h1{font-family:var(--font-display);font-size:22px;margin:0;font-weight:700;}
.topbar .sub{color:var(--ink-muted);font-size:12.5px;margin-top:3px;font-family:var(--font-mono);}
.ticker{
  border:1px solid var(--line);background:var(--bg-deep);border-radius:10px;
  padding:9px 14px;font-family:var(--font-mono);font-size:11.5px;color:var(--chalk);
  display:flex;align-items:center;gap:10px;white-space:nowrap;overflow:hidden;max-width:420px;
}

.frame{
  position:relative;border:1px solid var(--line-strong);background:var(--panel);
  border-radius:12px;padding:18px;
}
.frame::before,.frame::after{
  content:"";position:absolute;width:10px;height:10px;border:1.5px solid var(--chalk);opacity:.6;
}
.frame::before{top:-1px;left:-1px;border-right:none;border-bottom:none;border-top-left-radius:6px;}
.frame::after{bottom:-1px;right:-1px;border-left:none;border-top:none;border-bottom-right-radius:6px;}

.grid{display:grid;gap:16px;}
.kpis{grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-bottom:18px;}
.kpi-label{font-family:var(--font-mono);font-size:10.5px;color:var(--ink-muted);text-transform:uppercase;letter-spacing:1px;}
.kpi-value{font-family:var(--font-display);font-size:30px;font-weight:700;margin-top:6px;}
.kpi-delta{font-size:11.5px;margin-top:4px;color:var(--ink-muted);}

.section-title{font-family:var(--font-display);font-weight:700;font-size:16px;margin:26px 0 12px;display:flex;align-items:center;gap:10px;}
.section-title .bar{width:20px;height:2px;background:var(--amber);}

.cards2{grid-template-columns:2fr 1fr;}
@media(max-width:980px){.cards2{grid-template-columns:1fr;}}
.cards3{grid-template-columns:repeat(3,1fr);}
@media(max-width:980px){.cards3{grid-template-columns:1fr;}}

table{width:100%;border-collapse:collapse;font-size:13px;}
th{text-align:left;font-family:var(--font-mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.8px;color:var(--ink-muted);padding:8px 10px;border-bottom:1px solid var(--line-strong);}
td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:rgba(255,255,255,0.02);}

.badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;font-family:var(--font-mono);}
.badge.good{background:rgba(52,211,153,.14);color:var(--good);}
.badge.bad{background:rgba(248,113,113,.14);color:var(--bad);}
.badge.warn{background:rgba(251,191,36,.14);color:var(--warn);}
.badge.chalk{background:rgba(125,211,252,.14);color:var(--chalk);}

.btn{
  font-family:var(--font-body);font-weight:600;font-size:12.5px;
  padding:8px 14px;border-radius:7px;border:1px solid var(--line-strong);
  background:transparent;color:var(--ink);cursor:pointer;transition:.12s;
}
.btn:hover{border-color:var(--chalk);color:var(--chalk);}
.btn.primary{background:var(--chalk);color:var(--bg-deep);border-color:var(--chalk);}
.btn.primary:hover{background:#a8e2fc;color:var(--bg-deep);}
.btn.amber{background:var(--amber);color:var(--bg-deep);border-color:var(--amber);}
.btn.ghost{border-color:transparent;color:var(--ink-muted);}
.btn.ghost:hover{color:var(--bad);border-color:transparent;}
.btn.sm{padding:5px 10px;font-size:11.5px;}
.btn:disabled{opacity:.4;cursor:not-allowed;}

input,select{
  font-family:var(--font-body);background:var(--bg-deep);border:1px solid var(--line-strong);
  color:var(--ink);border-radius:7px;padding:8px 10px;font-size:13px;width:100%;
}
input::placeholder{color:var(--ink-muted);}
label{font-size:11.5px;color:var(--ink-muted);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.6px;display:block;margin-bottom:5px;}
.field{margin-bottom:12px;}
.formrow{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}

.tabbar{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;}
.tabbtn{padding:7px 14px;border-radius:7px;font-size:12.5px;font-weight:600;cursor:pointer;color:var(--ink-muted);border:1px solid var(--line);}
.tabbtn.active{background:var(--bg-deep);color:var(--chalk);border-color:var(--chalk);}

.modal-bg{position:fixed;inset:0;background:rgba(6,15,26,.65);backdrop-filter:blur(2px);display:none;align-items:center;justify-content:center;z-index:50;}
.modal-bg.open{display:flex;}
.modal{background:var(--panel);border:1px solid var(--line-strong);border-radius:12px;padding:22px;width:420px;max-width:92vw;max-height:88vh;overflow:auto;}
.modal h3{font-family:var(--font-display);margin:0 0 14px;font-size:16px;}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;}

.empty{color:var(--ink-muted);font-size:12.5px;padding:20px;text-align:center;font-family:var(--font-mono);}

/* Attendance / camera */
.camwrap{display:flex;gap:20px;flex-wrap:wrap;}
.camstage{position:relative;width:340px;height:255px;border-radius:12px;overflow:hidden;background:var(--bg-deep);border:1px solid var(--line-strong);flex-shrink:0;}
.camstage video, .camstage canvas{width:100%;height:100%;object-fit:cover;}
.camstage canvas{position:absolute;top:0;left:0;pointer-events:none;}
.guide{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:150px;height:190px;border:2px dashed rgba(125,211,252,.55);border-radius:50%;pointer-events:none;
}
.camstate{position:absolute;bottom:8px;left:8px;right:8px;font-family:var(--font-mono);font-size:10.5px;background:rgba(10,33,56,.75);padding:5px 9px;border-radius:6px;color:var(--chalk);}
.thumbs{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;}
.thumb{width:44px;height:44px;border-radius:8px;overflow:hidden;border:1px solid var(--line-strong);}
.thumb img{width:100%;height:100%;object-fit:cover;}
.roster{flex:1;min-width:260px;}
.roster-row{display:flex;align-items:center;gap:10px;padding:8px 6px;border-bottom:1px solid var(--line);}
.roster-row img{width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid var(--line-strong);}
.roster-row .name{font-weight:600;font-size:13px;}
.roster-row .meta{font-size:11px;color:var(--ink-muted);font-family:var(--font-mono);}

.hint{font-size:12px;color:var(--ink-muted);line-height:1.6;}
.calibrow{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--line);}
.calibrow:last-child{border-bottom:none;}

.chart-box{height:230px;}

.view{display:none;}
.view.active{display:block;}

.progress{height:6px;border-radius:4px;background:rgba(255,255,255,.08);overflow:hidden;margin-top:6px;}
.progress > div{height:100%;background:var(--chalk);}

@media(max-width:820px){
  .app{grid-template-columns:1fr;}
  .sidebar{position:relative;height:auto;flex-direction:row;overflow-x:auto;align-items:center;}
  .navgroup-label{display:none;}
  .sidebar-foot{display:none;}
}
</style>
</head>
<body>
<div class="app">
  <div class="sidebar">
    <div class="brand">
      <div class="brand-mark">LG</div>
      <div>
        <div class="brand-name">LabGrid</div>
        <div class="brand-sub">Cloud Lab Console</div>
      </div>
    </div>
    <div class="navgroup-label">Overview</div>
    <div class="navbtn active" data-view="dashboard"><span class="dot"></span>Dashboard</div>
    <div class="navgroup-label">Laboratories</div>
    <div class="navbtn" data-view="de"><span class="dot"></span>Digital Electronics</div>
    <div class="navbtn" data-view="nano"><span class="dot"></span>Nanotechnology</div>
    <div class="navbtn" data-view="iot"><span class="dot"></span>IoT Lab</div>
    <div class="navgroup-label">Operations</div>
    <div class="navbtn" data-view="attendance"><span class="dot"></span>Face Attendance</div>
    <div class="navbtn" data-view="bookings"><span class="dot"></span>Bookings</div>
    <div class="navbtn" data-view="reports"><span class="dot"></span>Reports</div>
    <div class="sidebar-foot"><span class="pulse"></span> Cloud sync active<br>Data stored privately to your account</div>
  </div>

  <div class="main">

    <!-- DASHBOARD -->
    <div class="view active" id="view-dashboard">
      <div class="topbar">
        <div>
          <h1>Lab Operations Overview</h1>
          <div class="sub" id="today-str">—</div>
        </div>
        <div class="ticker" id="ticker">Loading live status…</div>
      </div>

      <div class="grid kpis">
        <div class="frame"><div class="kpi-label">Total Resources</div><div class="kpi-value" id="k-total">–</div><div class="kpi-delta">Across 3 laboratories</div></div>
        <div class="frame"><div class="kpi-label">Available Now</div><div class="kpi-value" id="k-avail">–</div><div class="kpi-delta" id="k-avail-sub">Ready to book</div></div>
        <div class="frame"><div class="kpi-label">Needs Maintenance / Calibration</div><div class="kpi-value" id="k-maint">–</div><div class="kpi-delta">Flagged items</div></div>
        <div class="frame"><div class="kpi-label">Today's Attendance</div><div class="kpi-value" id="k-att">–</div><div class="kpi-delta" id="k-att-sub">Marked via face recognition</div></div>
      </div>

      <div class="grid cards2">
        <div class="frame">
          <div style="font-family:var(--font-display);font-weight:700;font-size:14.5px;margin-bottom:10px;">Resource Utilization by Lab</div>
          <div class="chart-box"><canvas id="chart-util"></canvas></div>
        </div>
        <div class="frame">
          <div style="font-family:var(--font-display);font-weight:700;font-size:14.5px;margin-bottom:10px;">Calibration &amp; Maintenance Alerts</div>
          <div id="dash-alerts"></div>
        </div>
      </div>

      <div class="section-title"><span class="bar"></span>Recent Activity</div>
      <div class="frame"><table><thead><tr><th>Time</th><th>Event</th><th>Lab</th></tr></thead><tbody id="activity-body"></tbody></table></div>
    </div>

    <!-- DIGITAL ELECTRONICS -->
    <div class="view" id="view-de">
      <div class="topbar">
        <div><h1>Digital Electronics Lab</h1><div class="sub">IC kits · Trainer kits · Oscilloscopes</div></div>
        <button class="btn primary" onclick="openItemModal('de')">+ Add Equipment</button>
      </div>
      <div class="frame">
        <table>
          <thead><tr><th>Equipment</th><th>Category</th><th>Total</th><th>Available</th><th>In Use</th><th>Status</th><th></th></tr></thead>
          <tbody id="de-body"></tbody>
        </table>
      </div>
    </div>

    <!-- NANOTECH -->
    <div class="view" id="view-nano">
      <div class="topbar">
        <div><h1>Nanotechnology Lab</h1><div class="sub">Chemical inventory · Sample tracking · Calibration</div></div>
        <button class="btn primary" onclick="openItemModal('nanoChem')">+ Add Chemical</button>
      </div>

      <div class="section-title"><span class="bar"></span>Chemical Inventory</div>
      <div class="frame">
        <table><thead><tr><th>Chemical</th><th>Quantity</th><th>Hazard Level</th><th>Expiry</th><th>Status</th><th></th></tr></thead>
        <tbody id="nano-chem-body"></tbody></table>
      </div>

      <div class="grid cards2" style="margin-top:20px;">
        <div class="frame">
          <div class="section-title" style="margin-top:0;"><span class="bar"></span>Sample Count</div>
          <table><thead><tr><th>Batch</th><th>Samples</th><th>Stored In</th><th></th></tr></thead><tbody id="nano-sample-body"></tbody></table>
          <button class="btn sm" style="margin-top:10px;" onclick="openItemModal('nanoSample')">+ Log Sample Batch</button>
        </div>
        <div class="frame">
          <div class="section-title" style="margin-top:0;"><span class="bar"></span>Calibration Reminders</div>
          <div id="nano-calib-list"></div>
          <button class="btn sm" style="margin-top:10px;" onclick="openItemModal('nanoCalib')">+ Add Instrument</button>
        </div>
      </div>
    </div>

    <!-- IOT -->
    <div class="view" id="view-iot">
      <div class="topbar">
        <div><h1>IoT Lab</h1><div class="sub">Dev boards · Connected devices · Sensor kits</div></div>
        <button class="btn primary" onclick="openItemModal('iotBoard')">+ Add Boards</button>
      </div>

      <div class="section-title"><span class="bar"></span>Development Boards</div>
      <div class="frame">
        <table><thead><tr><th>Board</th><th>Total</th><th>Available</th><th>In Use</th><th>Status</th><th></th></tr></thead><tbody id="iot-board-body"></tbody></table>
      </div>

      <div class="grid cards2" style="margin-top:20px;">
        <div class="frame">
          <div class="section-title" style="margin-top:0;"><span class="bar"></span>Connected IoT Devices</div>
          <table><thead><tr><th>Device</th><th>Location</th><th>Status</th></tr></thead><tbody id="iot-device-body"></tbody></table>
          <button class="btn sm" style="margin-top:10px;" onclick="openItemModal('iotDevice')">+ Add Device</button>
        </div>
        <div class="frame">
          <div class="section-title" style="margin-top:0;"><span class="bar"></span>Sensor Kits</div>
          <table><thead><tr><th>Sensor Kit</th><th>Total</th><th>Available</th></tr></thead><tbody id="iot-sensor-body"></tbody></table>
          <button class="btn sm" style="margin-top:10px;" onclick="openItemModal('iotSensor')">+ Add Sensor Kit</button>
        </div>
      </div>
    </div>

    <!-- ATTENDANCE -->
    <div class="view" id="view-attendance">
      <div class="topbar">
        <div><h1>Face Recognition Attendance</h1><div class="sub">Register students once, then mark attendance from live camera</div></div>
      </div>

      <div class="tabbar">
        <div class="tabbtn active" data-atab="mark">Mark Attendance</div>
        <div class="tabbtn" data-atab="register">Register Student</div>
        <div class="tabbtn" data-atab="log">Today's Log</div>
      </div>

      <div id="atab-mark">
        <div class="frame">
          <div class="camwrap">
            <div>
              <div class="camstage">
                <video id="video-mark" autoplay muted playsinline></video>
                <div class="guide"></div>
                <div class="camstate" id="mark-state">Camera off</div>
              </div>
              <div style="display:flex;gap:8px;margin-top:10px;">
                <button class="btn primary" id="btn-cam-start" onclick="startCamera('mark')">Start Camera</button>
                <button class="btn amber" id="btn-recognize" onclick="recognizeFace()" disabled>Scan &amp; Mark Present</button>
              </div>
              <p class="hint" style="margin-top:10px;">Center your face inside the oval, hold still, then click <b>Scan &amp; Mark Present</b>. Matching runs entirely in your browser against registered face captures.</p>
            </div>
            <div class="roster">
              <div style="font-family:var(--font-display);font-weight:700;font-size:14px;margin-bottom:8px;">Registered Students (<span id="roster-count">0</span>)</div>
              <div id="roster-list"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="atab-register" style="display:none;">
        <div class="frame">
          <div class="camwrap">
            <div>
              <div class="camstage">
                <video id="video-register" autoplay muted playsinline></video>
                <div class="guide"></div>
                <div class="camstate" id="reg-state">Camera off</div>
              </div>
              <div style="display:flex;gap:8px;margin-top:10px;">
                <button class="btn primary" onclick="startCamera('register')">Start Camera</button>
                <button class="btn" id="btn-capture" onclick="captureFace()" disabled>Capture Face</button>
              </div>
              <div class="thumbs" id="capture-thumb"></div>
            </div>
            <div style="flex:1;min-width:240px;">
              <div class="field"><label>Full Name</label><input id="reg-name" placeholder="e.g. Aarav Sharma"></div>
              <div class="field"><label>Roll No. / ID</label><input id="reg-roll" placeholder="e.g. IT2024-041"></div>
              <div class="field"><label>Course / Lab Batch</label><input id="reg-batch" placeholder="e.g. IoT Lab — Batch B"></div>
              <button class="btn primary" onclick="saveStudent()">Save Student</button>
              <p class="hint" style="margin-top:12px;">Capture 1 clear frontal photo in good light. You can re-capture before saving.</p>
            </div>
          </div>
        </div>
      </div>

      <div id="atab-log" style="display:none;">
        <div class="frame">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
            <div style="font-family:var(--font-display);font-weight:700;font-size:14.5px;">Attendance — <span id="log-date"></span></div>
            <button class="btn sm" onclick="exportCSV()">Export CSV</button>
          </div>
          <table><thead><tr><th>Student</th><th>Roll No.</th><th>Time Marked</th><th>Match Confidence</th><th>Status</th></tr></thead><tbody id="log-body"></tbody></table>
        </div>
      </div>
    </div>

    <!-- BOOKINGS -->
    <div class="view" id="view-bookings">
      <div class="topbar">
        <div><h1>Resource Bookings</h1><div class="sub">Reserve lab equipment and avoid double-booking</div></div>
        <button class="btn primary" onclick="openBookingModal()">+ New Booking</button>
      </div>
      <div class="frame">
        <table><thead><tr><th>Lab</th><th>Resource</th><th>Booked By</th><th>Date</th><th>Slot</th><th>Purpose</th><th>Status</th><th></th></tr></thead><tbody id="bookings-body"></tbody></table>
      </div>
    </div>

    <!-- REPORTS -->
    <div class="view" id="view-reports">
      <div class="topbar"><div><h1>Reports</h1><div class="sub">Attendance history and inventory summary</div></div></div>
      <div class="grid cards2">
        <div class="frame">
          <div style="font-family:var(--font-display);font-weight:700;font-size:14.5px;margin-bottom:10px;">Attendance by Date</div>
          <table><thead><tr><th>Date</th><th>Present</th><th>Registered</th><th>Rate</th></tr></thead><tbody id="report-att-body"></tbody></table>
        </div>
        <div class="frame">
