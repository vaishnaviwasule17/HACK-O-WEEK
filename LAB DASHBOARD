let utilChart, invChart;
function renderDashboard(){
  document.getElementById('today-str').textContent = new Date().toLocaleDateString([], {weekday:'long', year:'numeric', month:'long', day:'numeric'});

  const totalDE = DB.de.reduce((s,r)=>s+r.total,0);
  const totalIoTb = DB.iotBoard.reduce((s,r)=>s+r.total,0);
  const totalIoTs = DB.iotSensor.reduce((s,r)=>s+r.total,0);
  const totalNano = DB.nanoChem.length + DB.nanoSample.reduce((s,r)=>s+ (parseInt(r.count)||0),0);
  const totalAll = totalDE + totalIoTb + totalIoTs + DB.nanoChem.length;

  const availDE = DB.de.reduce((s,r)=>s+(r.total-r.inUse),0);
  const availIoT = DB.iotBoard.reduce((s,r)=>s+(r.total-r.inUse),0);
  const availAll = availDE + availIoT + DB.iotSensor.reduce((s,r)=>s+r.avail,0);

  const overdueCalib = DB.nanoCalib.filter(c=>daysUntil(c.next)<14).length;
  const expiringChem = DB.nanoChem.filter(c=>daysUntil(c.expiry)<45).length;

  document.getElementById('k-total').textContent = totalAll;
  document.getElementById('k-avail').textContent = availAll;
  document.getElementById('k-avail-sub').textContent = totalAll? Math.round(availAll/totalAll*100)+'% of fleet free' : '—';
  document.getElementById('k-maint').textContent = overdueCalib + expiringChem;

  const todays = DB.attendance.filter(a=>a.date===todayStr()).length;
  document.getElementById('k-att').textContent = DB.students.length? `${todays}/${DB.students.length}` : '0/0';
  document.getElementById('k-att-sub').textContent = DB.students.length? Math.round(todays/DB.students.length*100)+'% present today' : 'No students registered';

  // ticker
  const tickerBits = [];
  if(overdueCalib) tickerBits.push(`⚠ ${overdueCalib} instrument(s) due for calibration`);
  if(expiringChem) tickerBits.push(`⚠ ${expiringChem} chemical(s) nearing expiry`);
  const lowStock = [...DB.de, ...DB.iotBoard].filter(r=>(r.total-r.inUse)<=Math.max(1,r.total*0.1));
  if(lowStock.length) tickerBits.push(`${lowStock.length} item(s) running low`);
  document.getElementById('ticker').textContent = tickerBits.length? tickerBits.join('   •   ') : 'All systems nominal — no alerts';

  // alerts panel
  const alerts = [
    ...DB.nanoCalib.filter(c=>daysUntil(c.next)<14).map(c=>({label:c.name, sub:`Calibration due ${c.next}`, bad:daysUntil(c.next)<0})),
    ...DB.nanoChem.filter(c=>daysUntil(c.expiry)<45).map(c=>({label:c.name, sub:`Expires ${c.expiry}`, bad:daysUntil(c.expiry)<0})),
  ];
  document.getElementById('dash-alerts').innerHTML = alerts.length ? alerts.map(a=>
    `<div class="calibrow"><div><div style="font-weight:600;">${a.label}</div><div class="hint">${a.sub}</div></div>
     <span class="badge ${a.bad?'bad':'warn'}">${a.bad?'Overdue':'Due Soon'}</span></div>`
  ).join('') : `<div class="empty">No pending alerts.</div>`;

  document.getElementById('activity-body').innerHTML = DB.activity.slice(0,10).map(a=>
    `<tr><td style="font-family:var(--font-mono);font-size:11.5px;color:var(--ink-muted);">${a.time}</td><td>${a.text}</td><td><span class="badge chalk">${a.lab}</span></td></tr>`
  ).join('') || `<tr><td colspan="3" class="empty">No activity yet.</td></tr>`;

  // chart
  const ctx = document.getElementById('chart-util');
  const labs = ['Digital Electronics','Nanotechnology','IoT Lab'];
  const inUseData = [DB.de.reduce((s,r)=>s+r.inUse,0), DB.nanoChem.length, DB.iotBoard.reduce((s,r)=>s+r.inUse,0)];
  const availData = [availDE, DB.nanoSample.reduce((s,r)=>s+(parseInt(r.count)||0),0), availIoT];
  if(utilChart) utilChart.destroy();
  utilChart = new Chart(ctx, {
    type:'bar',
    data:{ labels:labs, datasets:[
      {label:'In Use / Logged', data:inUseData, backgroundColor:'#F5A524'},
      {label:'Available', data:availData, backgroundColor:'#7DD3FC'},
    ]},
    options:{ responsive:true, maintainAspectRatio:false,
      scales:{ x:{ticks:{color:'#9FB8D1'}, grid:{color:'rgba(255,255,255,0.06)'}}, y:{ticks:{color:'#9FB8D1'}, grid:{color:'rgba(255,255,255,0.06)'}}},
      plugins:{ legend:{labels:{color:'#EAF2FB', font:{family:'IBM Plex Sans', size:11}}}}
    }
  });
}

function renderReports(){
  const byDate = {};
  DB.attendance.forEach(a=>{ byDate[a.date] = (byDate[a.date]||0)+1; });
  const dates = Object.keys(byDate).sort().reverse();
  document.getElementById('report-att-body').innerHTML = dates.map(d=>{
    const present = byDate[d];
    const total = DB.students.length || 1;
    return `<tr><td>${d}</td><td>${present}</td><td>${DB.students.length}</td><td>${Math.round(present/total*100)}%</td></tr>`;
  }).join('') || `<tr><td colspan="4" class="empty">No attendance history yet.</td></tr>`;

  const ctx = document.getElementById('chart-inv');
  if(invChart) invChart.destroy();
  invChart = new Chart(ctx, {
    type:'doughnut',
    data:{ labels:['Digital Electronics','Nanotechnology Items','IoT Boards','IoT Sensor Kits'],
      datasets:[{ data:[DB.de.reduce((s,r)=>s+r.total,0), DB.nanoChem.length+DB.nanoSample.length, DB.iotBoard.reduce((s,r)=>s+r.total,0), DB.iotSensor.reduce((s,r)=>s+r.total,0)],
      backgroundColor:['#7DD3FC','#F5A524','#34D399','#F87171'] }]},
    options:{ responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'bottom', labels:{color:'#EAF2FB', font:{family:'IBM Plex Sans', size:11}}}} }
  });
}

/* ---------------- Master render ---------------- */
function renderAllViews(){
  renderDE(); renderNano(); renderIoT(); renderBookings(); renderRoster(); renderLog(); renderDashboard();
}

(async function init(){
  await loadAll();
  renderAllViews();
})();
</script>
</body>
</html>
